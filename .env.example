# Kopie als .env.local anlegen und mit lokalen Werten fuellen.
# NIEMALS echte Produktionswerte oder Secrets committen (PROJECT_PRINCIPLES.md 3.3).
#
# Es gehoeren AUSSCHLIESSLICH oeffentliche, clientseitig unkritische Werte in
# VITE_*-Variablen. Alles mit VITE_-Praefix landet im Browser-Bundle.
#
# Der Supabase service_role key darf NIEMALS hier stehen und NIEMALS in den
# Browser gelangen (ADR-015, Sicherheitsregeln).

# --- Frontend (oeffentlich, landet im Bundle) --------------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=platzhalter-lokaler-anon-key

# Kachelschluessel des Kartendienstes fuer den Kartenprototyp /touren/karte
# (MAP-002, ADR-019 Punkt 19 und 24). OPTIONAL: Fehlt er, zeigt die Karte den
# Hinweis "Kartenkacheln nicht konfiguriert" und es geht keine Anfrage an den
# Anbieter hinaus.
#
# Dieser Schluessel ist im Browser sichtbar und deshalb kein Secret, sondern
# eine Abrechnungskennung mit Missbrauchsrisiko - er gehoert trotzdem nur in
# die ungetrackte .env.local. Der serverseitige Schluessel fuer Geocoding,
# Routing und Matrix ist ein ANDERER, ist ein Secret und kommt erst mit
# MAP-003 als Supabase-Secret.
VITE_PTV_TILE_API_KEY=
#
# Seit ABN-028 (ADR-019 Fassung 5, Punkt 35) laedt die Karte Kacheln nur,
# wenn die Edge Function location-provider meldet, dass ihr Schalter offen
# ist. Die Secrets der Function stehen NICHT hier, sondern in der
# ungetrackten supabase/functions/.env.local, zum Beispiel:
#   LOCATION_PROVIDER=mock            (oder ptv mit PTV_API_KEY)
#   LOCATION_DATA_GATE=synthetic
#   APP_ENVIRONMENT=development       (fehlt es, gilt Produktion: Punkt 36)

# --- Tests (nur lokal / CI, nicht im Browser-Bundle) -------------------------
# Verbindungsstring der Wegwerf-Testdatenbank fuer Migrations- und RLS-Tests.
# Enthaelt ausschliesslich synthetische Daten (PROJECT_PRINCIPLES.md 3.1).
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres

# --- E2E ---------------------------------------------------------------------
E2E_BASE_URL=http://127.0.0.1:5173

# Echte End-to-End-Tests hinter der Anmeldung laufen nur, wenn BEIDE folgenden
# Variablen gesetzt sind. Die Werte liefert `supabase status` fuer die lokale
# Wegwerf-Instanz; sie aendern sich pro Umgebung und gehoeren deshalb NICHT ins
# Repository. Der anon key ist ein oeffentlicher Clientwert, aber ein JWT -
# der Secret-Scan wuerde ihn zu Recht als Fund melden.
E2E_SUPABASE_URL=http://127.0.0.1:54321
E2E_SUPABASE_ANON_KEY=
