{
  /* Edge Functions laufen in Deno und haben deshalb ein eigenes Projekt:
     Importe mit `.ts`-Endung (Deno verlangt sie), keine Node-Typen, und die
     Deno-Erklaerung aus `supabase/functions/deno.d.ts`. Die Tests der
     Functions liegen im Testprojekt, damit sie dort dieselben globalen Typen
     haben wie alle anderen Tests. */
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "noEmit": true,
    "types": [],
    "allowImportingTsExtensions": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.functions.tsbuildinfo"
  },
  "include": ["supabase/functions"],
  "exclude": ["supabase/functions/**/*.test.ts"]
}
