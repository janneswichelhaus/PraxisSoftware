-- Setzt die Test-Umgebung neu auf (OPS-002a). Aufruf nur aus dem Workflow:
--
--   psql "$TESTENV_DATABASE_URL" --single-transaction -v ON_ERROR_STOP=1 \
--     -f supabase/testumgebung/neu-aufsetzen.psql
--
-- Das Kennwort liest psql aus der Umgebungsvariable, nicht von der
-- Befehlszeile - so steht es in keiner Prozessliste und keinem Log.
\set QUIET on
\getenv passwort TESTENV_LOGIN_PASSWORD
\if :{?passwort}
\else
  \set passwort ''
\endif
select set_config('praxis.zugang_passwort', :'passwort', false) \g /dev/null
\unset passwort
\set QUIET off

\ir kennung.sql
-- Passkeys und App-PIN überstehen den Seed (Jannes 2026-11-08).
\ir anmeldung-sichern.sql
-- Erst nach der Kennung: Was die Bedienung anlegt (Notizen, Zahlungen, Urlaub), kennt der Seed
-- nicht, und ON DELETE RESTRICT hielte sein Löschen auf. Kataloge ohne Praxisbezug bleiben.
set client_min_messages = warning;
truncate public.organizations cascade;
reset client_min_messages;
\ir ../seed.sql
\ir testpatienten.sql
\ir praxiswoche.sql
\ir zugang.sql
\ir anmeldung-zurueck.sql
